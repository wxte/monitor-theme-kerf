{
  "name": "Kerf",
  "short": "kerf",
  "description": "黑白极简，细线断笔标题字，终端式实时报告",
  "version": "1.6.0",
  "author": "wxte",
  "url": "https://github.com/wxte/monitor-theme-kerf",
  "config": [
    {"type": "title", "label": "首页"},
    {"key": "hero_title", "type": "string", "label": "大标题", "default": "", "help": "留空则显示站点名称"},
    {"key": "hero_subtitle", "type": "text", "label": "副标题", "default": "实时服务器状态，每 2 秒刷新一次。"},
    {"key": "notice", "type": "text", "label": "公告", "default": "", "help": "显示在大标题上方，留空不显示"},
    {"key": "show_terminal", "type": "boolean", "label": "显示终端报告", "default": true, "help": "大标题下方按实时流量排列的节点报告"},
    {"key": "terminal_rows", "type": "number", "label": "终端报告行数", "default": 5, "min": 1, "max": 20},
    {"key": "layout", "type": "select", "label": "节点布局", "default": "cards", "options": [{"value": "cards", "label": "卡片"}, {"value": "list", "label": "列表"}]},
    {"type": "title", "label": "节点卡片"},
    {"key": "country_style", "type": "select", "label": "国家显示", "default": "text", "options": [{"value": "text", "label": "文字（JP）"}, {"value": "color", "label": "彩色国旗"}, {"value": "grey", "label": "灰色国旗"}]},
    {"key": "show_price", "type": "boolean", "label": "显示价格", "default": true},
    {"key": "show_latency", "type": "boolean", "label": "显示延迟", "default": true, "help": "卡片和列表显示各线路最近 1 小时的延迟折线、当前延迟和丢包率；只请求屏幕上看得到的节点，每 30 秒一次"},
    {"key": "show_specs", "type": "boolean", "label": "显示规格清单", "default": false, "help": "卡片底部列出 CPU 型号、内存、磁盘、网速、系统、运行时间、到期日，这些在节点详情里也有"},
    {"key": "show_expiry", "type": "boolean", "label": "到期提醒", "default": true, "help": "7 天内到期或已过期时在卡片上提示，到期日期在节点详情里"},
    {"type": "title", "label": "页脚"},
    {"key": "footer_text", "type": "string", "label": "页脚说明", "default": "", "help": "显示在页脚站点名下方，留空不显示"}
  ]
}
